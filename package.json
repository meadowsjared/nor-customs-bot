{
  "name": "customs-cruncher",
  "version": "6.0.5",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx index.ts",
    "check:db": "bun scripts/csvImport.ts missing-from-db",
    "check:csv": "bun scripts/csvImport.ts missing-from-csv",
    "check:match": "bun scripts/csvImport.ts check-matches",
    "import:csv": "bun scripts/csvImport.ts import-csv",
    "csv:help": "bun scripts/csvImport.ts --help",
    "migrate:sqlite": "bun scripts/migrateFromSqlite.ts",
    "db:sync": "bun scripts/syncDb.ts",
    "db:dev-to-prod": "bun scripts/syncDb.ts dev-to-prod",
    "db:prod-to-dev": "bun scripts/syncDb.ts prod-to-dev",
    "start": "echo \"Current version: v$npm_package_version\"; echo \"v$npm_package_version\" > .running_version; sudo systemctl start customs-cruncher.service",
    "stop": "R=$(cat .running_version 2>/dev/null || echo 'unknown'); echo \"Current version: v$npm_package_version\"; echo \"Stopped version: $R\"; sudo systemctl stop customs-cruncher.service",
    "status": "R=$(cat .running_version 2>/dev/null || echo 'unknown'); echo \"Current version: v$npm_package_version\"; echo \"Running version: $R\"; systemctl status customs-cruncher.service --no-pager",
    "logs": "tail -f out.log",
    "logs:all": "less +F out.log",
    "restart": "bun stop && sleep 2 && bun start",
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "test": "bun test",
    "postinstall": "node node_modules/heroprotocol/postinstall.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "csv-parse": "^7.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.9",
    "hots-parser": "^7.55.7",
    "postgres": "^4.0.0",
    "puppeteer": "^25.16.0",
    "puppeteer-real-browser": "^1.4.4",
    "regenerator-runtime": "^0.14.1",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/sharp": "^0.32.0",
    "eslint": "^10.13.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1"
  }
}
