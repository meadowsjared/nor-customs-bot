{
  "name": "nor-customs",
  "version": "3.4.1",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx index.ts",
    "check:db": "bun tsx utils/csvImport.ts missing-from-db",
    "check:csv": "bun tsx utils/csvImport.ts missing-from-csv",
    "check:match": "bun tsx utils/csvImport.ts check-matches",
    "import:csv": "bun tsx utils/csvImport.ts import-csv",
    "csv:help": "bun tsx utils/csvImport.ts --help",
    "start": "echo \"Current version: v$npm_package_version\"; echo \"v$npm_package_version\" > .running_version; sudo systemctl start nor-customs-bot.service",
    "stop": "R=$(cat .running_version 2>/dev/null || echo 'unknown'); echo \"Current version: v$npm_package_version\"; echo \"Stopped version: $R\"; sudo systemctl stop nor-customs-bot.service",
    "status": "R=$(cat .running_version 2>/dev/null || echo 'unknown'); echo \"Current version: v$npm_package_version\"; echo \"Running version: $R\"; systemctl status nor-customs-bot.service --no-pager",
    "logs": "tail -f out.log",
    "logs:all": "less +F out.log",
    "restart": "bun stop && sleep 2 && bun start",
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "postinstall": "node node_modules/heroprotocol/postinstall.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "csv-parse": "^7.0.1",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "hots-parser": "^7.55.7",
    "puppeteer": "^25.4.0",
    "puppeteer-real-browser": "^1.4.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
